[Unit]
Description=Telegram bot: habits, goals, books
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/bot_habits
ExecStart=/opt/bot_habits/.venv/bin/python main.py
Restart=always
RestartSec=5
EnvironmentFile=/opt/bot_habits/.env

[Install]
WantedBy=multi-user.target
